# Python ignores.
.pytest_cache/
.venv/
venv/
.cache/
.DS_Store
__pycache__/
*.pyc
*.pyo
*.pyd

# Documentation output.
/site/

# C and CMake ignores.
build/
install/
compile_commands.json
CMakeSettings.json
*egg-info/
cmake-build-*/
prefix/
CMakeLists.txt.user
CMakeUserPresets.json
.ccls

.idea/
.vs/
*.code-workspace
.vscode/launch.json
.luarocks

# Claude
*.local.json
scratch/

# Slang
.slang/local/

# Format test diff artifacts (*.cst.json, *.actual.sv, *.reformat.sv, etc.)
# Golden outputs (*.out.sv) are un-ignored so new tests can be added.
tests/format/**/*.*.*
!tests/format/**/*.out.sv

# Proprietary format test cases
tests/format/prop/
